      },
      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n</style>\n<div class=\"relative min-h-screen w-full overflow-hidden bg-white\" data-kid=\"1\" style=\"font-family:'Inter', system-ui, sans-serif;\">\n<!-- Dimmed backdrop: plain scrim, no product page behind it -->\n<div class=\"absolute inset-0 bg-slate-950/60\" data-kid=\"1-1\"></div>\n<div class=\"pointer-events-none absolute inset-0\" data-kid=\"1-2\" style=\"background: radial-gradient(115% 80% at 50% 44%, rgba(2,6,23,0.10) 0%, rgba(2,6,23,0.34) 88%);\"></div>\n<div class=\"relative flex min-h-screen w-full items-center justify-center px-4 py-10\" data-kid=\"1-3\">\n<div aria-labelledby=\"recovery-title\" aria-modal=\"true\" class=\"relative w-[480px] max-w-[calc(100vw-32px)] rounded-[18px] bg-white p-6 shadow-[0_26px_80px_-24px_rgba(2,6,23,0.62),0_2px_8px_-2px_rgba(2,6,23,0.14)]\" data-kid=\"1-3-1\" id=\"recovery-dialog\" role=\"dialog\">\n<!-- Close -->\n<button aria-label=\"Close\" class=\"absolute right-4 top-4 flex h-8 w-8 items-center justify-center rounded-[9px] text-slate-400 hover:bg-slate-100 hover:text-slate-600\" data-kid=\"1-3-1-1\" type=\"button\">\n<i class=\"icon-x text-[15px] leading-none\" data-kid=\"1-3-1-1-1\"></i>\n</button>\n<!-- Header -->\n<div class=\"flex items-center gap-3 pr-9\" data-kid=\"1-3-1-2\">\n<div class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-[14px] bg-[#060a12]\" data-kid=\"1-3-1-2-1\">\n<img alt=\"Radora\" class=\"h-[22px] w-[22px] object-contain\" data-kid=\"1-3-1-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logo/Next.png\"/>\n</div>\n<div class=\"min-w-0\" data-kid=\"1-3-1-2-2\">\n<h2 class=\"text-[19px] font-semibold leading-tight tracking-[-0.015em] text-slate-900\" data-kid=\"1-3-1-2-2-1\" id=\"recovery-title\">\n            Enter verification code\n          </h2>\n<p class=\"mt-1 text-[12px] font-medium text-slate-500\" data-kid=\"1-3-1-2-2-2\">Step 2 of 3</p>\n</div>\n</div>\n<!-- Progress: first two steps complete -->\n<div aria-hidden=\"true\" class=\"mt-4 flex gap-1.5\" data-kid=\"1-3-1-3\">\n<div class=\"h-[3px] flex-1 rounded-full bg-indigo-600\" data-kid=\"1-3-1-3-1\"></div>\n<div class=\"h-[3px] flex-1 rounded-full bg-indigo-600\" data-kid=\"1-3-1-3-2\"></div>\n<div class=\"h-[3px] flex-1 rounded-full bg-slate-200\" data-kid=\"1-3-1-3-3\"></div>\n</div>\n<!-- Body -->\n<div class=\"mt-5\" data-kid=\"1-3-1-4\">\n<p class=\"text-[13px] leading-[1.55] text-slate-600\" data-kid=\"1-3-1-4-1\">\n          A 6-digit code was sent to the recovery address on the account.\n        </p>\n<div class=\"mt-4\" data-kid=\"1-3-1-4-2\">\n<p class=\"text-[12px] font-medium text-slate-700\" data-kid=\"1-3-1-4-2-1\">Email or roll number</p>\n<div class=\"mt-1.5 flex h-11 items-center gap-2.5 rounded-[11px] border border-slate-200 bg-slate-50 px-3\" data-kid=\"1-3-1-4-2-2\">\n<i class=\"icon-shield-check text-[16px] leading-none text-indigo-600\" data-kid=\"1-3-1-4-2-2-1\"></i>\n<span class=\"text-[13.5px] font-medium text-slate-900\" data-kid=\"1-3-1-4-2-2-2\" style=\"font-family:'Geist Mono', ui-monospace, monospace;\">DEMO-2404</span>\n</div>\n</div>\n<div class=\"mt-4\" data-kid=\"1-3-1-4-3\">\n<label class=\"text-[13px] font-medium text-slate-900\" data-kid=\"1-3-1-4-3-1\" id=\"otp-label\">6-digit code</label>\n<div aria-labelledby=\"otp-label\" class=\"mt-2 flex items-center gap-[9px]\" data-kid=\"1-3-1-4-3-2\" role=\"group\">\n<div class=\"flex h-11 w-11 items-center justify-center rounded-[10px] border border-slate-200 bg-slate-50 text-[17px] font-medium text-slate-900\" data-kid=\"1-3-1-4-3-2-1\" style=\"font-family:'Geist Mono', ui-monospace, monospace;\">4</div>\n<div class=\"flex h-11 w-11 items-center justify-center rounded-[10px] border border-slate-200 bg-slate-50 text-[17px] font-medium text-slate-900\" data-kid=\"1-3-1-4-3-2-2\" style=\"font-family:'Geist Mono', ui-monospace, monospace;\">7</div>\n<div class=\"flex h-11 w-11 items-center justify-center rounded-[10px] border border-slate-200 bg-slate-50 text-[17px] font-medium text-slate-900\" data-kid=\"1-3-1-4-3-2-3\" style=\"font-family:'Geist Mono', ui-monospace, monospace;\">1</div>\n<div class=\"flex h-11 w-11 items-center justify-center rounded-[10px] border border-slate-200 bg-slate-50 text-[17px] font-medium text-slate-900\" data-kid=\"1-3-1-4-3-2-4\" style=\"font-family:'Geist Mono', ui-monospace, monospace;\">9</div>\n<div class=\"flex h-11 w-11 items-center justify-center rounded-[10px] border border-slate-200 bg-slate-50 text-[17px] font-medium text-slate-900\" data-kid=\"1-3-1-4-3-2-5\" style=\"font-family:'Geist Mono', ui-monospace, monospace;\">2</div>\n<!-- Focused sixth slot -->\n<div class=\"relative flex h-11 w-11 items-center justify-center rounded-[10px] border border-indigo-600 bg-white ring-[3px] ring-indigo-600/12\" data-kid=\"1-3-1-4-3-2-6\">\n<span class=\"block h-[18px] w-[2px] rounded-full bg-indigo-600\" data-kid=\"1-3-1-4-3-2-6-1\" id=\"otp-caret\"></span>\n</div>\n</div>\n<!-- Reserved error line: feedback does not move the footer -->\n<div class=\"mt-2 flex h-5 items-center\" data-kid=\"1-3-1-4-3-3\">\n<p class=\"text-[12px] font-medium text-rose-600/85\" data-kid=\"1-3-1-4-3-3-1\">Invalid or expired code.</p>\n</div>\n</div>\n</div>\n<!-- Footer -->\n<div class=\"mt-4 border-t border-slate-100 pt-4\" data-kid=\"1-3-1-5\">\n<div class=\"flex items-center justify-between gap-3\" data-kid=\"1-3-1-5-1\">\n<button class=\"text-[12px] font-medium text-slate-600 underline decoration-slate-300 decoration-1 underline-offset-[3px] hover:text-slate-900 hover:decoration-slate-500\" data-kid=\"1-3-1-5-1-1\" type=\"button\">\n            Change email or roll number\n          </button>\n<button class=\"shrink-0 text-[12px] font-medium tabular-nums text-slate-400\" data-kid=\"1-3-1-5-1-2\" id=\"resend\" type=\"button\">Resend code in <span data-kid=\"1-3-1-5-1-2-1\" id=\"resend-value\">0:18</span></button>\n</div>\n<button class=\"mt-3.5 flex h-11 w-full items-center justify-center gap-2 rounded-[11px] bg-indigo-600 text-[14px] font-medium text-white shadow-[0_6px_16px_-8px_rgba(79,70,229,0.7)] hover:bg-indigo-700\" data-kid=\"1-3-1-5-2\" type=\"button\">\n          Verify code\n          <i class=\"icon-arrow-right text-[15px] leading-none\" data-kid=\"1-3-1-5-2-1\"></i>\n</button>\n</div>\n</div>\n</div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script>\n  (function () {\n    var dialog = document.getElementById('recovery-dialog');\n    var caret = document.getElementById('otp-caret');\n\n    if (window.gsap && dialog) {\n      gsap.fromTo(dialog,\n        { opacity: 0, y: 14, scale: 0.985 },\n        { opacity: 1, y: 0, scale: 1, duration: 0.3, ease: 'power2.out', clearProps: 'transform,opacity' }\n      );\n      if (caret) {\n        gsap.fromTo(caret,\n          { opacity: 1 },\n          { opacity: 0, duration: 0.6, repeat: -1, yoyo: true, ease: 'power1.inOut', delay: 0.45 }\n        );\n      }\n    }\n\n    // Resend cooldown: counts down, then restarts the cycle.\n    var resend = document.getElementById('resend');\n    var value = document.getElementById('resend-value');\n    var remaining = 18;\n    if (resend && value) {\n      setInterval(function () {\n        remaining -= 1;\n        if (remaining <= 0) {\n          resend.textContent = 'Resend code';\n          resend.classList.remove('text-slate-400');\n          resend.classList.add('text-indigo-600');\n          setTimeout(function () {\n            remaining = 18;\n            resend.innerHTML = 'Resend code in <span id=\"resend-value\">0:18</span>';\n            resend.classList.add('text-slate-400');\n            resend.classList.remove('text-indigo-600');\n          }, 2600);\n        } else {\n          var live = document.getElementById('resend-value');\n          if (live) live.textContent = '0:' + String(remaining).padStart(2, '0');\n        }\n      }, 1000);\n    }\n  })();\n</script>",
