      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n\n:root{\n  --page: oklch(0.145 0.015 265);\n  --panel: oklch(0.185 0.015 265);\n  --card: oklch(0.205 0.015 265);\n  --raised: oklch(0.269 0.015 265);\n  --line: oklch(0.30 0.02 265);\n  --ink: oklch(0.985 0 0);\n  --ink-2: oklch(0.84 0.008 265);\n  --ink-3: oklch(0.708 0.01 265);\n  --primary: oklch(0.62 0.19 265);\n  --primary-strong: oklch(0.70 0.17 265);\n  --emerald: oklch(0.72 0.17 160);\n}\n\n@layer components{\n  .mono{ font-family:'Geist Mono', ui-monospace, monospace; font-variant-numeric: tabular-nums; }\n\n  .lesson-row{\n    display:flex; align-items:center; gap:12px; width:100%; height:44px;\n    padding:0 10px; border-radius:10px; text-align:left;\n    background:transparent; cursor:pointer;\n    transition: background-color .16s ease;\n  }\n  .lesson-row:hover{ background: color-mix(in oklch, var(--raised) 55%, transparent); }\n  .lesson-row .r-time{ font-family:'Geist Mono', monospace; font-variant-numeric: tabular-nums; flex:0 0 42px; font-size:12px; color:var(--ink-3); }\n  .lesson-row .r-subject{ flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:13px; font-weight:500; color:var(--ink-2); }\n  .lesson-row .r-section{ flex:0 0 auto; font-size:11px; color:var(--ink-3); }\n  .lesson-row .r-dot{ flex:0 0 auto; width:6px; height:6px; border-radius:999px; background:var(--emerald); opacity:0; }\n  .lesson-row.is-active{ background:var(--raised); }\n  .lesson-row.is-active .r-time{ color:var(--primary-strong); }\n  .lesson-row.is-active .r-subject{ color:var(--ink); font-weight:600; }\n  .lesson-row.is-active .r-dot{ opacity:1; }\n\n  .asm-row{\n    flex:1 1 0; min-height:44px;\n    display:grid; grid-template-columns:68px 1fr 38px; align-items:center; gap:12px;\n    border-top:1px solid color-mix(in oklch, var(--line) 70%, transparent);\n    padding:0 8px; margin:0 -8px;\n  }\n  .asm-row .a-class{ font-size:12.5px; color:var(--ink-2); white-space:nowrap; }\n  .asm-row .a-bar{ display:block; height:6px; border-radius:999px; background:var(--raised); overflow:hidden; }\n  .asm-row .a-bar > span{ display:block; height:100%; border-radius:999px; background: color-mix(in oklch, var(--ink) 24%, transparent); }\n  .asm-row .a-score{ font-family:'Geist Mono', monospace; font-variant-numeric: tabular-nums; font-size:12.5px; text-align:right; color:var(--ink-2); }\n  .asm-row.is-active{ background:var(--raised); border-radius:10px; border-top-color:transparent; }\n  .asm-row.is-active .a-class{ color:var(--ink); font-weight:600; }\n  .asm-row.is-active .a-bar{ background: var(--card); }\n  .asm-row.is-active .a-bar > span{ background: var(--primary); }\n  .asm-row.is-active .a-score{ color:var(--ink); }\n}\n</style>\n<div class=\"min-h-screen w-full overflow-x-clip bg-[var(--page)] text-[var(--ink)]\" data-kid=\"1\" style=\"font-family:'Inter', system-ui, sans-serif;\">\n<div class=\"mx-auto flex min-h-screen w-full max-w-[1440px] flex-col px-8 pb-8 pt-8\" data-kid=\"1-1\">\n<header class=\"flex h-14 shrink-0 items-center justify-between\" data-kid=\"1-1-1\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\">\n<div class=\"flex h-10 w-10 items-center justify-center overflow-hidden rounded-[14px] bg-[#060a12] ring-1 ring-[var(--line)]\" data-kid=\"1-1-1-1-1\">\n<img alt=\"Radora\" class=\"h-10 w-10 object-cover\" data-kid=\"1-1-1-1-1-1\" decoding=\"async\" height=\"40\" loading=\"lazy\" src=\"/api/local/images/public/logo/Next.png\" width=\"40\"/>\n</div>\n<div class=\"flex items-baseline gap-2\" data-kid=\"1-1-1-1-2\">\n<span class=\"text-[15px] font-semibold tracking-[-0.01em]\" data-kid=\"1-1-1-1-2-1\">Radora</span>\n<span class=\"text-[12px] font-medium text-[var(--ink-3)]\" data-kid=\"1-1-1-1-2-2\">Next</span>\n</div>\n</div>\n<div class=\"flex items-center gap-3\" data-kid=\"1-1-1-2\">\n<span class=\"text-[11px] tracking-[0.02em] text-[var(--ink-3)]\" data-kid=\"1-1-1-2-1\">Sample data</span>\n<span class=\"h-4 w-px bg-[var(--line)]\" data-kid=\"1-1-1-2-2\"></span>\n<button class=\"flex h-9 items-center gap-2 rounded-full px-3 text-[12px] font-medium text-[var(--ink-2)] ring-1 ring-[var(--line)] transition-colors hover:bg-[var(--raised)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-2-3\" id=\"pauseBtn\" type=\"button\">\n<i class=\"icon-pause\" data-kid=\"1-1-1-2-3-1\" id=\"pauseIcon\" style=\"font-size:13px;line-height:1;\"></i>\n<span data-kid=\"1-1-1-2-3-2\" id=\"pauseLabel\">Pause preview</span>\n</button>\n</div>\n</header>\n<main class=\"mt-6 grid min-h-0 flex-1 grid-cols-[416px_480px_432px] gap-6\" data-kid=\"1-1-2\">\n<!-- Timetable context -->\n<section class=\"flex h-full min-h-0 flex-col rounded-[20px] bg-[var(--panel)] p-5\" data-kid=\"1-1-2-1\">\n<div class=\"flex shrink-0 items-center justify-between\" data-kid=\"1-1-2-1-1\">\n<span class=\"text-[12px] font-medium text-[var(--ink-3)]\" data-kid=\"1-1-2-1-1-1\">Timetable</span>\n<button class=\"flex h-8 items-center gap-1.5 rounded-full bg-[var(--raised)] px-2.5 text-[12px] font-medium text-[var(--ink-2)] transition-colors hover:text-[var(--ink)]\" data-kid=\"1-1-2-1-1-2\" type=\"button\">\n<span data-kid=\"1-1-2-1-1-2-1\">Class 8 · A</span>\n<i class=\"icon-chevron-down\" data-kid=\"1-1-2-1-1-2-2\" style=\"font-size:12px;line-height:1;\"></i>\n</button>\n</div>\n<div class=\"mt-4 flex shrink-0 items-baseline gap-2.5\" data-kid=\"1-1-2-1-2\">\n<span class=\"mono text-[32px] font-medium leading-none tracking-[-0.02em]\" data-kid=\"1-1-2-1-2-1\" id=\"clock\">08:45</span>\n<span class=\"text-[11px] font-medium uppercase tracking-[0.14em] text-[var(--ink-3)]\" data-kid=\"1-1-2-1-2-2\">Tuesday</span>\n</div>\n<div class=\"mt-4 flex shrink-0 flex-col gap-0.5\" data-kid=\"1-1-2-1-3\" id=\"lessonRows\">\n<button class=\"lesson-row is-active\" data-i=\"0\" data-kid=\"1-1-2-1-3-1\" type=\"button\">\n<span class=\"r-time\" data-kid=\"1-1-2-1-3-1-1\">08:30</span>\n<span class=\"r-subject\" data-kid=\"1-1-2-1-3-1-2\">Mathematics</span>\n<span class=\"r-section\" data-kid=\"1-1-2-1-3-1-3\">Class 8 · A</span>\n<span class=\"r-dot\" data-kid=\"1-1-2-1-3-1-4\"></span>\n</button>\n<button class=\"lesson-row\" data-i=\"1\" data-kid=\"1-1-2-1-3-2\" type=\"button\">\n<span class=\"r-time\" data-kid=\"1-1-2-1-3-2-1\">09:15</span>\n<span class=\"r-subject\" data-kid=\"1-1-2-1-3-2-2\">Science</span>\n<span class=\"r-section\" data-kid=\"1-1-2-1-3-2-3\">Class 8 · B</span>\n<span class=\"r-dot\" data-kid=\"1-1-2-1-3-2-4\"></span>\n</button>\n<button class=\"lesson-row\" data-i=\"2\" data-kid=\"1-1-2-1-3-3\" type=\"button\">\n<span class=\"r-time\" data-kid=\"1-1-2-1-3-3-1\">10:15</span>\n<span class=\"r-subject\" data-kid=\"1-1-2-1-3-3-2\">English</span>\n<span class=\"r-section\" data-kid=\"1-1-2-1-3-3-3\">Class 7 · B</span>\n<span class=\"r-dot\" data-kid=\"1-1-2-1-3-3-4\"></span>\n</button>\n<button class=\"lesson-row\" data-i=\"3\" data-kid=\"1-1-2-1-3-4\" type=\"button\">\n<span class=\"r-time\" data-kid=\"1-1-2-1-3-4-1\">11:15</span>\n<span class=\"r-subject\" data-kid=\"1-1-2-1-3-4-2\">Social Studies</span>\n<span class=\"r-section\" data-kid=\"1-1-2-1-3-4-3\">Class 9 · B</span>\n<span class=\"r-dot\" data-kid=\"1-1-2-1-3-4-4\"></span>\n</button>\n<button class=\"lesson-row\" data-i=\"4\" data-kid=\"1-1-2-1-3-5\" type=\"button\">\n<span class=\"r-time\" data-kid=\"1-1-2-1-3-5-1\">12:15</span>\n<span class=\"r-subject\" data-kid=\"1-1-2-1-3-5-2\">Sports</span>\n<span class=\"r-section\" data-kid=\"1-1-2-1-3-5-3\">Class 8 · A</span>\n<span class=\"r-dot\" data-kid=\"1-1-2-1-3-5-4\"></span>\n</button>\n</div>\n<div class=\"mt-4 flex min-h-0 flex-1 flex-col rounded-[14px] bg-[var(--raised)] p-4\" data-kid=\"1-1-2-1-4\">\n<div class=\"flex items-start justify-between gap-3\" data-kid=\"1-1-2-1-4-1\">\n<div class=\"min-w-0 flex-1\" data-kid=\"1-1-2-1-4-1-1\" id=\"detailFields\">\n<p class=\"truncate text-[15px] font-semibold leading-tight text-[var(--ink)]\" data-kid=\"1-1-2-1-4-1-1-1\" id=\"dSubject\">Mathematics</p>\n<p class=\"mt-1 truncate text-[12px] text-[var(--ink-3)]\" data-kid=\"1-1-2-1-4-1-1-2\" id=\"dTeacher\">Ms. Mira Shah</p>\n<dl class=\"mt-4 grid grid-cols-2 gap-x-3 gap-y-3\" data-kid=\"1-1-2-1-4-1-1-3\">\n<div data-kid=\"1-1-2-1-4-1-1-3-1\">\n<dt class=\"text-[11px] text-[var(--ink-3)]\" data-kid=\"1-1-2-1-4-1-1-3-1-1\">Class</dt>\n<dd class=\"mt-0.5 text-[12px] text-[var(--ink)]\" data-kid=\"1-1-2-1-4-1-1-3-1-2\" id=\"dClass\">Class 8 · A</dd>\n</div>\n<div data-kid=\"1-1-2-1-4-1-1-3-2\">\n<dt class=\"text-[11px] text-[var(--ink-3)]\" data-kid=\"1-1-2-1-4-1-1-3-2-1\">Room</dt>\n<dd class=\"mt-0.5 text-[12px] text-[var(--ink)]\" data-kid=\"1-1-2-1-4-1-1-3-2-2\" id=\"dRoom\">302</dd>\n</div>\n<div class=\"col-span-2\" data-kid=\"1-1-2-1-4-1-1-3-3\">\n<dt class=\"text-[11px] text-[var(--ink-3)]\" data-kid=\"1-1-2-1-4-1-1-3-3-1\">Period</dt>\n<dd class=\"mono mt-0.5 text-[12px] text-[var(--ink)]\" data-kid=\"1-1-2-1-4-1-1-3-3-2\" id=\"dPeriod\">08:30 – 09:10</dd>\n</div>\n</dl>\n</div>\n<span class=\"flex shrink-0 items-center gap-1.5 rounded-full bg-[var(--panel)] px-2 py-[5px] text-[11px] font-medium text-[var(--ink-2)]\" data-kid=\"1-1-2-1-4-1-2\">\n<span class=\"h-1.5 w-1.5 rounded-full bg-[var(--emerald)]\" data-kid=\"1-1-2-1-4-1-2-1\"></span>\n              In session\n            </span>\n</div>\n<div class=\"mt-auto pt-5\" data-kid=\"1-1-2-1-4-2\">\n<div class=\"flex items-baseline justify-between text-[11px] text-[var(--ink-3)]\" data-kid=\"1-1-2-1-4-2-1\">\n<span class=\"mono\" data-kid=\"1-1-2-1-4-2-1-1\" id=\"dElapsed\">15 min elapsed</span>\n<span class=\"mono\" data-kid=\"1-1-2-1-4-2-1-2\" id=\"dTotal\">40 min</span>\n</div>\n<div class=\"mt-2 h-1 w-full overflow-hidden rounded-full bg-[var(--panel)]\" data-kid=\"1-1-2-1-4-2-2\">\n<div class=\"h-1 rounded-full bg-[var(--primary)]\" data-kid=\"1-1-2-1-4-2-2-1\" id=\"dMarker\" style=\"width:37.5%;\"></div>\n</div>\n</div>\n</div>\n</section>\n<!-- Authentication -->\n<section class=\"flex h-full min-h-0 flex-col rounded-[24px] bg-[var(--card)] p-8\" data-kid=\"1-1-2-2\">\n<div class=\"flex flex-1 flex-col justify-center\" data-kid=\"1-1-2-2-1\">\n<h1 class=\"text-[30px] font-semibold leading-none tracking-[-0.025em] text-[var(--ink)]\" data-kid=\"1-1-2-2-1-1\">Sign in</h1>\n<form class=\"mt-9\" data-kid=\"1-1-2-2-1-2\" novalidate=\"\">\n<label class=\"block text-[13px] font-medium text-[var(--ink-2)]\" data-kid=\"1-1-2-2-1-2-1\" for=\"identifier\">Email or roll number</label>\n<input autocomplete=\"username\" class=\"mt-2 h-12 w-full rounded-[10px] bg-[var(--page)] px-3.5 text-[14px] text-[var(--ink)] outline-none ring-1 ring-[var(--line)] transition-shadow placeholder:text-[var(--ink-3)] focus:ring-2 focus:ring-[var(--primary)]\" data-kid=\"1-1-2-2-1-2-2\" id=\"identifier\" name=\"identifier\" placeholder=\"Email address or roll number\" type=\"text\"/>\n<div class=\"mt-5 flex items-center justify-between\" data-kid=\"1-1-2-2-1-2-3\">\n<label class=\"block text-[13px] font-medium text-[var(--ink-2)]\" data-kid=\"1-1-2-2-1-2-3-1\" for=\"password\">Password</label>\n<a class=\"text-[12px] font-medium text-[var(--primary-strong)] transition-colors hover:text-[var(--ink)]\" data-kid=\"1-1-2-2-1-2-3-2\" href=\"#\">Forgot password?</a>\n</div>\n<div class=\"relative mt-2\" data-kid=\"1-1-2-2-1-2-4\">\n<input autocomplete=\"current-password\" class=\"h-12 w-full rounded-[10px] bg-[var(--page)] pl-3.5 pr-12 text-[14px] text-[var(--ink)] outline-none ring-1 ring-[var(--line)] transition-shadow placeholder:text-[var(--ink-3)] focus:ring-2 focus:ring-[var(--primary)]\" data-kid=\"1-1-2-2-1-2-4-1\" id=\"password\" name=\"password\" placeholder=\"Enter your password\" type=\"password\"/>\n<button aria-label=\"Show password\" class=\"absolute right-1.5 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-md text-[var(--ink-3)] transition-colors hover:text-[var(--ink)]\" data-kid=\"1-1-2-2-1-2-4-2\" id=\"pwToggle\" type=\"button\">\n<i class=\"icon-eye\" data-kid=\"1-1-2-2-1-2-4-2-1\" id=\"pwIcon\" style=\"font-size:16px;line-height:1;\"></i>\n</button>\n</div>\n<div class=\"mt-3 min-h-[22px]\" data-kid=\"1-1-2-2-1-2-5\">\n<p class=\"hidden items-center gap-2 rounded-[8px] bg-[#2a1520] px-2.5 py-1.5 text-[12px] text-[#ffb4b4]\" data-kid=\"1-1-2-2-1-2-5-1\" id=\"authError\" role=\"alert\">\n<span class=\"h-1.5 w-1.5 shrink-0 rounded-full bg-[#ff8f8f]\" data-kid=\"1-1-2-2-1-2-5-1-1\"></span>\n<span data-kid=\"1-1-2-2-1-2-5-1-2\">Incorrect password for this account.</span>\n</p>\n</div>\n<button class=\"mt-2 flex h-12 w-full items-center justify-center rounded-[10px] bg-[var(--primary)] text-[15px] font-semibold text-white transition-colors hover:bg-[var(--primary-strong)]\" data-kid=\"1-1-2-2-1-2-6\" type=\"submit\">\n              Sign In\n            </button>\n</form>\n</div>\n<div class=\"shrink-0 pt-8\" data-kid=\"1-1-2-2-2\">\n<p class=\"text-center text-[12px] leading-5 text-[var(--ink-3)]\" data-kid=\"1-1-2-2-2-1\">\n            By signing in, you agree to our\n            <a class=\"text-[var(--ink-2)] underline decoration-[var(--line)] underline-offset-2 transition-colors hover:text-[var(--ink)]\" data-kid=\"1-1-2-2-2-1-1\" href=\"#\">Terms of Service</a>\n            and\n            <a class=\"text-[var(--ink-2)] underline decoration-[var(--line)] underline-offset-2 transition-colors hover:text-[var(--ink)]\" data-kid=\"1-1-2-2-2-1-2\" href=\"#\">Privacy Policy</a>.\n          </p>\n<div class=\"mt-6 h-px w-full bg-[var(--line)]\" data-kid=\"1-1-2-2-2-2\"></div>\n<a class=\"group mt-5 flex h-12 items-center justify-between rounded-[10px] px-3.5 text-[13px] font-medium text-[var(--ink-2)] ring-1 ring-[var(--line)] transition-colors hover:bg-[var(--raised)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-2-2-3\" href=\"#\">\n<span data-kid=\"1-1-2-2-2-3-1\">Explore Radora</span>\n<i class=\"icon-chevron-down -rotate-90\" data-kid=\"1-1-2-2-2-3-2\" style=\"font-size:14px;line-height:1;\"></i>\n</a>\n</div>\n</section>\n<!-- Attendance and assessment evidence -->\n<section class=\"flex h-full min-h-0 flex-col rounded-[20px] bg-[var(--panel)] p-5\" data-kid=\"1-1-2-3\">\n<div class=\"shrink-0\" data-kid=\"1-1-2-3-1\">\n<div class=\"flex items-start justify-between gap-3\" data-kid=\"1-1-2-3-1-1\">\n<div data-kid=\"1-1-2-3-1-1-1\">\n<p class=\"text-[12px] font-medium text-[var(--ink-3)]\" data-kid=\"1-1-2-3-1-1-1-1\">School attendance</p>\n<p class=\"mt-1 text-[11px] text-[var(--ink-3)]\" data-kid=\"1-1-2-3-1-1-1-2\">January – June 2026</p>\n</div>\n<div class=\"flex items-baseline gap-0.5\" data-kid=\"1-1-2-3-1-1-2\">\n<span class=\"mono text-[26px] font-medium leading-none text-[var(--ink)]\" data-kid=\"1-1-2-3-1-1-2-1\">97</span>\n<span class=\"text-[13px] text-[var(--ink-3)]\" data-kid=\"1-1-2-3-1-1-2-2\">%</span>\n</div>\n</div>\n<svg aria-label=\"School attendance by month, January to June 2026: 91, 94, 92, 96, 95 and 97 percent\" class=\"mt-3 w-full\" data-kid=\"1-1-2-3-1-2\" role=\"img\" viewbox=\"0 0 392 200\">\n<defs>\n<lineargradient id=\"attFill\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\">\n<stop offset=\"0%\" stop-color=\"oklch(0.62 0.19 265)\" stop-opacity=\"0.30\"></stop>\n<stop offset=\"100%\" stop-color=\"oklch(0.62 0.19 265)\" stop-opacity=\"0\"></stop>\n</lineargradient>\n</defs>\n<g stroke=\"oklch(0.30 0.02 265)\" stroke-width=\"1\">\n<line x1=\"30\" x2=\"386\" y1=\"16\" y2=\"16\"></line>\n<line x1=\"30\" x2=\"386\" y1=\"74.3\" y2=\"74.3\"></line>\n<line x1=\"30\" x2=\"386\" y1=\"132.7\" y2=\"132.7\"></line>\n<line x1=\"30\" x2=\"386\" y1=\"156\" y2=\"156\"></line>\n</g>\n<g fill=\"oklch(0.708 0.01 265)\" font-family=\"Geist Mono, monospace\" font-size=\"9\" text-anchor=\"end\">\n<text x=\"22\" y=\"19\">100%</text>\n<text x=\"22\" y=\"77.3\">95</text>\n<text x=\"22\" y=\"135.7\">90</text>\n</g>\n<path d=\"M30,121 L101.2,86 L172.4,109.33 L243.6,62.67 L314.8,74.33 L386,51 L386,156 L30,156 Z\" fill=\"url(#attFill)\"></path>\n<polyline fill=\"none\" id=\"attLine\" points=\"30,121 101.2,86 172.4,109.33 243.6,62.67 314.8,74.33 386,51\" stroke=\"oklch(0.62 0.19 265)\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"></polyline>\n<g fill=\"oklch(0.185 0.015 265)\" id=\"attDots\" stroke=\"oklch(0.62 0.19 265)\" stroke-width=\"1.5\">\n<circle cx=\"30\" cy=\"121\" r=\"2.6\"></circle>\n<circle cx=\"101.2\" cy=\"86\" r=\"2.6\"></circle>\n<circle cx=\"172.4\" cy=\"109.33\" r=\"2.6\"></circle>\n<circle cx=\"243.6\" cy=\"62.67\" r=\"2.6\"></circle>\n<circle cx=\"314.8\" cy=\"74.33\" r=\"2.6\"></circle>\n</g>\n<circle cx=\"386\" cy=\"51\" fill=\"oklch(0.62 0.19 265)\" opacity=\"0.22\" r=\"7\"></circle>\n<circle cx=\"386\" cy=\"51\" fill=\"oklch(0.62 0.19 265)\" r=\"3.6\"></circle>\n<g fill=\"oklch(0.708 0.01 265)\" font-family=\"Geist Mono, monospace\" font-size=\"9\" text-anchor=\"middle\">\n<text x=\"30\" y=\"180\">Jan</text>\n<text x=\"101.2\" y=\"180\">Feb</text>\n<text x=\"172.4\" y=\"180\">Mar</text>\n<text x=\"243.6\" y=\"180\">Apr</text>\n<text x=\"314.8\" y=\"180\">May</text>\n<text x=\"386\" y=\"180\">Jun</text>\n</g>\n</svg>\n</div>\n<div class=\"mt-5 h-px w-full shrink-0 bg-[var(--line)]\" data-kid=\"1-1-2-3-2\"></div>\n<div class=\"mt-5 flex min-h-0 flex-1 flex-col\" data-kid=\"1-1-2-3-3\">\n<div class=\"grid shrink-0 grid-cols-[68px_1fr_38px] items-center gap-3 px-2 text-[11px] text-[var(--ink-3)]\" data-kid=\"1-1-2-3-3-1\">\n<span data-kid=\"1-1-2-3-3-1-1\">Class</span>\n<span data-kid=\"1-1-2-3-3-1-2\">Term 2 average</span>\n<span class=\"mono text-right\" data-kid=\"1-1-2-3-3-1-3\">/100</span>\n</div>\n<div class=\"mt-2 flex min-h-0 flex-1 flex-col\" data-kid=\"1-1-2-3-3-2\">\n<div class=\"asm-row\" data-kid=\"1-1-2-3-3-2-1\">\n<span class=\"a-class\" data-kid=\"1-1-2-3-3-2-1-1\">Class 6</span>\n<span class=\"a-bar\" data-kid=\"1-1-2-3-3-2-1-2\"><span data-kid=\"1-1-2-3-3-2-1-2-1\" style=\"width:82%;\"></span></span>\n<span class=\"a-score\" data-kid=\"1-1-2-3-3-2-1-3\">82</span>\n</div>\n<div class=\"asm-row\" data-kid=\"1-1-2-3-3-2-2\">\n<span class=\"a-class\" data-kid=\"1-1-2-3-3-2-2-1\">Class 7</span>\n<span class=\"a-bar\" data-kid=\"1-1-2-3-3-2-2-2\"><span data-kid=\"1-1-2-3-3-2-2-2-1\" style=\"width:88%;\"></span></span>\n<span class=\"a-score\" data-kid=\"1-1-2-3-3-2-2-3\">88</span>\n</div>\n<div class=\"asm-row is-active\" data-kid=\"1-1-2-3-3-2-3\">\n<span class=\"a-class\" data-kid=\"1-1-2-3-3-2-3-1\">Class 8</span>\n<span class=\"a-bar\" data-kid=\"1-1-2-3-3-2-3-2\"><span data-kid=\"1-1-2-3-3-2-3-2-1\" style=\"width:79%;\"></span></span>\n<span class=\"a-score\" data-kid=\"1-1-2-3-3-2-3-3\">79</span>\n</div>\n<div class=\"asm-row\" data-kid=\"1-1-2-3-3-2-4\">\n<span class=\"a-class\" data-kid=\"1-1-2-3-3-2-4-1\">Class 9</span>\n<span class=\"a-bar\" data-kid=\"1-1-2-3-3-2-4-2\"><span data-kid=\"1-1-2-3-3-2-4-2-1\" style=\"width:91%;\"></span></span>\n<span class=\"a-score\" data-kid=\"1-1-2-3-3-2-4-3\">91</span>\n</div>\n<div class=\"asm-row\" data-kid=\"1-1-2-3-3-2-5\">\n<span class=\"a-class\" data-kid=\"1-1-2-3-3-2-5-1\">Class 10</span>\n<span class=\"a-bar\" data-kid=\"1-1-2-3-3-2-5-2\"><span data-kid=\"1-1-2-3-3-2-5-2-1\" style=\"width:86%;\"></span></span>\n<span class=\"a-score\" data-kid=\"1-1-2-3-3-2-5-3\">86</span>\n</div>\n</div>\n</div>\n</section>\n</main>\n</div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script>\n(function () {\n  var lessons = [\n    { office: '08:30', subject: 'Mathematics', section: 'Class 8 · A', staff: 'Ms. Mira Shah', room: '302', period: '08:30 – 09:10', start: 510, end: 550 },\n    { office: '09:15', subject: 'Science', section: 'Class 8 · B', staff: 'Mr. Arjun Das', room: 'Lab 2', period: '09:15 – 10:00', start: 555, end: 600 },\n    { office: '10:15', subject: 'English', section: 'Class 7 · B', staff: 'Ms. Neha Rao', room: '214', period: '10:15 – 11:00', start: 615, end: 660 },\n    { office: '11:15', subject: 'Social Studies', section: 'Class 9 · B', staff: 'Mr. Ishaan Mehta', room: '118', period: '11:15 – 12:00', start: 675, end: 720 },\n    { office: '12:15', subject: 'Sports', section: 'Class 8 · A', staff: 'Sports ground', room: 'Sports ground', period: '12:15 – 13:00', start: 735, end: 780 }\n  ];\n\n  var CYCLE = 20000;\n  var SIM_MINUTES = 20;\n\n  var clockEl = document.getElementById('clock');\n  var marker = document.getElementById('dMarker');\n  var elapsedEl = document.getElementById('dElapsed');\n  var totalEl = document.getElementById('dTotal');\n  var detailFields = document.getElementById('detailFields');\n  var dSubject = document.getElementById('dSubject');\n  var dTeacher = document.getElementById('dTeacher');\n  var dClass = document.getElementById('dClass');\n  var dRoom = document.getElementById('dRoom');\n  var dPeriod = document.getElementById('dPeriod');\n  var rows = Array.prototype.slice.call(document.querySelectorAll('#lessonRows .lesson-row'));\n  var pauseBtn = document.getElementById('pauseBtn');\n  var pauseIcon = document.getElementById('pauseIcon');\n  var pauseLabel = document.getElementById('pauseLabel');\n\n  var elapsed = 0;\n  var last = performance.now();\n  var paused = false;\n  var current = 0;\n  var lastClock = '';\n\n  function pad(n) { return n < 10 ? '0' + n : '' + n; }\n\n  function formatTime(minutes) {\n    var m = Math.round(minutes) % 1440;\n    if (m < 0) { m += 1440; }\n    return pad(Math.floor(m / 60)) + ':' + pad(m % 60);\n  }\n\n  function applyLesson(i) {\n    var l = lessons[i];\n    dSubject.textContent = l.subject;\n    dTeacher.textContent = l.staff;\n    dClass.textContent = l.section;\n    dRoom.textContent = l.room;\n    dPeriod.textContent = l.period;\n    totalEl.textContent = (l.end - l.start) + ' min';\n    rows.forEach(function (row, ri) {\n      row.classList.toggle('is-active', ri === i);\n    });\n  }\n\n  function switchLesson(i) {\n    if (!window.gsap) { applyLesson(i); return; }\n    gsap.to(detailFields, {\n      opacity: 0,\n      duration: 0.16,\n      ease: 'power1.out',\n      onComplete: function () {\n        applyLesson(i);\n        gsap.to(detailFields, { opacity: 1, duration: 0.24, ease: 'power1.out' });\n      }\n    });\n  }\n\n  function paint(i, simMin) {\n    var l = lessons[i];\n    var text = formatTime(simMin);\n    if (text !== lastClock) { clockEl.textContent = text; lastClock = text; }\n    var pct = (simMin - l.start) / (l.end - l.start) * 100;\n    pct = Math.max(0, Math.min(100, pct));\n    marker.style.width = pct.toFixed(2) + '%';\n    elapsedEl.textContent = Math.max(0, Math.round(simMin - l.start)) + ' min elapsed';\n  }\n\n  function frame(now) {\n    var delta = now - last;\n    last = now;\n    if (!paused) { elapsed += delta; }\n\n    var total = CYCLE * lessons.length;\n    var pos = elapsed % total;\n    var idx = Math.floor(pos / CYCLE);\n    var within = pos - idx * CYCLE;\n    var simMin = lessons[idx].start + 15 + (within / CYCLE) * SIM_MINUTES;\n\n    if (idx !== current) { current = idx; switchLesson(idx); }\n    paint(idx, simMin);\n    requestAnimationFrame(frame);\n  }\n\n  pauseBtn.addEventListener('click', function () {\n    paused = !paused;\n    last = performance.now();\n    pauseIcon.className = paused ? 'icon-play' : 'icon-pause';\n    pauseLabel.textContent = paused ? 'Play preview' : 'Pause preview';\n  });\n\n  rows.forEach(function (row) {\n    row.addEventListener('click', function () {\n      var i = parseInt(row.getAttribute('data-i'), 10);\n      elapsed = i * CYCLE;\n      current = -1;\n    });\n  });\n\n  var pwToggle = document.getElementById('pwToggle');\n  var pwInput = document.getElementById('password');\n  var pwIcon = document.getElementById('pwIcon');\n  pwToggle.addEventListener('click', function () {\n    var show = pwInput.type === 'password';\n    pwInput.type = show ? 'text' : 'password';\n    pwIcon.className = show ? 'icon-eye-off' : 'icon-eye';\n    pwToggle.setAttribute('aria-label', show ? 'Hide password' : 'Show password');\n  });\n\n  applyLesson(0);\n  paint(0, lessons[0].start + 15);\n\n  if (window.gsap) {\n    var line = document.getElementById('attLine');\n    var len = line.getTotalLength();\n    gsap.set(line, { strokeDasharray: len, strokeDashoffset: len });\n    gsap.to(line, { strokeDashoffset: 0, duration: 1.5, ease: 'power2.out', delay: 0.15 });\n    gsap.from('#attDots circle', { opacity: 0, duration: 0.3, stagger: 0.07, delay: 0.6 });\n  }\n\n  requestAnimationFrame(frame);\n})();\n</script>",
