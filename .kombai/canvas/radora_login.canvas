      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n\n  .rd-mono { font-family: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace; font-variant-numeric: tabular-nums; }\n  .rd-micro { font-size: 10.5px; line-height: 1; letter-spacing: 0.085em; text-transform: uppercase; font-weight: 600; color: #94a3b8; }\n  .rd-tab { display: inline-flex; align-items: center; height: 40px; font-size: 13px; font-weight: 500; color: #64748b; border-bottom: 2px solid transparent; margin-bottom: -1px; cursor: pointer; background: none; transition: color 150ms ease, border-color 150ms ease; }\n  .rd-tab:hover { color: #334155; }\n  .rd-tab[aria-selected=\"true\"] { color: #0f172a; border-bottom-color: #0f172a; }\n  .rd-input { height: 48px; width: 100%; border-radius: 10px; border: 1px solid #e2e8f0; background: #ffffff; padding: 0 14px; font-size: 14px; color: #0f172a; box-shadow: 0 1px 2px rgba(15,23,42,0.03); outline: none; transition: border-color 150ms ease, box-shadow 150ms ease; }\n  .rd-input::placeholder { color: #94a3b8; }\n  .rd-input:focus { border-color: #6366f1; box-shadow: 0 0 0 4px rgba(99,102,241,0.12); }\n</style>\n<div class=\"min-h-[900px] w-full bg-[#f6f7fa] text-slate-900\" data-kid=\"1\" style=\"font-family:'Inter',ui-sans-serif,system-ui,sans-serif;-webkit-font-smoothing:antialiased\">\n<div class=\"mx-auto w-full max-w-[1440px] px-8 pt-6 pb-7\" data-kid=\"1-1\">\n<!-- Header -->\n<header class=\"flex h-12 items-center justify-between\" data-kid=\"1-1-1\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\">\n<div class=\"relative h-10 w-10 overflow-hidden rounded-[12px] bg-[#050912] ring-1 ring-slate-900/10\" data-kid=\"1-1-1-1-1\">\n<img alt=\"Radora\" class=\"h-full w-full object-cover\" data-kid=\"1-1-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logo/Next.png\" style=\"transform:scale(1.8)\"/>\n</div>\n<span class=\"text-[17px] font-semibold tracking-[-0.015em] text-slate-900\" data-kid=\"1-1-1-1-2\">Radora</span>\n</div>\n<button class=\"group inline-flex h-10 items-center gap-2 rounded-[10px] border border-slate-300/80 bg-white px-4 text-[13px] font-medium text-slate-700 shadow-[0_1px_2px_rgba(15,23,42,0.04)] transition-colors duration-150 hover:border-slate-400 hover:text-slate-900\" data-kid=\"1-1-1-2\" type=\"button\">\n        Explore Radora\n        <i class=\"icon-arrow-right transition-transform duration-150 group-hover:translate-x-0.5\" data-kid=\"1-1-1-2-1\" style=\"font-size:14px;color:#64748b\"></i>\n</button>\n</header>\n<!-- Authentication band -->\n<section class=\"mt-8 h-[224px] rounded-[16px] bg-white px-6 py-6 ring-1 ring-slate-200/80 shadow-[0_1px_2px_rgba(15,23,42,0.05),0_28px_50px_-42px_rgba(15,23,42,0.45)]\" data-kid=\"1-1-2\">\n<div class=\"flex h-full flex-col justify-between\" data-kid=\"1-1-2-1\">\n<div class=\"flex items-start gap-6\" data-kid=\"1-1-2-1-1\">\n<div class=\"w-[240px] shrink-0 pt-[1px]\" data-kid=\"1-1-2-1-1-1\">\n<h1 class=\"text-[26px] font-semibold leading-[1.15] tracking-[-0.025em] text-slate-900\" data-kid=\"1-1-2-1-1-1-1\">Sign in</h1>\n</div>\n<div class=\"w-[384px] shrink-0\" data-kid=\"1-1-2-1-1-2\">\n<label class=\"mb-2 block text-[12.5px] font-medium leading-4 text-slate-700\" data-kid=\"1-1-2-1-1-2-1\" for=\"rd-identifier\">Email or roll number</label>\n<input autocomplete=\"username\" class=\"rd-input\" data-kid=\"1-1-2-1-1-2-2\" id=\"rd-identifier\" name=\"identifier\" placeholder=\"Email address or roll number\" type=\"text\" value=\"aarav.mehta@radora.academy\"/>\n</div>\n<div class=\"w-[384px] shrink-0\" data-kid=\"1-1-2-1-1-3\">\n<label class=\"mb-2 block text-[12.5px] font-medium leading-4 text-slate-700\" data-kid=\"1-1-2-1-1-3-1\" for=\"rd-password\">Password</label>\n<div class=\"relative\" data-kid=\"1-1-2-1-1-3-2\">\n<input autocomplete=\"current-password\" class=\"rd-input pr-12\" data-kid=\"1-1-2-1-1-3-2-1\" id=\"rd-password\" name=\"password\" placeholder=\"••••••••\" type=\"password\"/>\n<button aria-label=\"Show password\" class=\"absolute right-2 top-1/2 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-md text-slate-400 transition-colors duration-150 hover:bg-slate-50 hover:text-slate-600\" data-kid=\"1-1-2-1-1-3-2-2\" id=\"rd-eye\" type=\"button\">\n<i class=\"icon-eye\" data-kid=\"1-1-2-1-1-3-2-2-1\" id=\"rd-eye-icon\" style=\"font-size:16px\"></i>\n</button>\n</div>\n<div class=\"mt-2\" data-kid=\"1-1-2-1-1-3-3\">\n<a class=\"text-[12px] font-medium leading-4 text-indigo-600 transition-colors duration-150 hover:text-indigo-700\" data-kid=\"1-1-2-1-1-3-3-1\" href=\"#\">Forgot password?</a>\n</div>\n</div>\n<div class=\"ml-auto w-[216px] shrink-0 pt-[24px]\" data-kid=\"1-1-2-1-1-4\">\n<button class=\"h-12 w-full rounded-[10px] bg-indigo-600 text-[14px] font-semibold text-white shadow-[0_10px_22px_-12px_rgba(79,70,229,0.9)] transition-colors duration-150 hover:bg-indigo-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-500/25\" data-kid=\"1-1-2-1-1-4-1\" type=\"submit\">\n              Sign In\n            </button>\n</div>\n</div>\n<div class=\"flex items-center justify-between gap-6 border-t border-slate-100 pt-3\" data-kid=\"1-1-2-1-2\">\n<p class=\"text-[11.5px] leading-4 text-slate-500\" data-kid=\"1-1-2-1-2-1\">\n            By signing in, you agree to our\n            <a class=\"font-medium text-slate-600 underline decoration-slate-300 underline-offset-2 transition-colors duration-150 hover:text-slate-900\" data-kid=\"1-1-2-1-2-1-1\" href=\"#\">Terms of Service</a>\n            and\n            <a class=\"font-medium text-slate-600 underline decoration-slate-300 underline-offset-2 transition-colors duration-150 hover:text-slate-900\" data-kid=\"1-1-2-1-2-1-2\" href=\"#\">Privacy Policy</a>.\n          </p>\n<p class=\"min-h-4 shrink-0 text-[11.5px] font-medium leading-4 text-rose-600\" data-kid=\"1-1-2-1-2-2\" id=\"rd-error\" role=\"alert\"></p>\n</div>\n</div>\n</section>\n<!-- Product workspace -->\n<section aria-label=\"Product preview\" class=\"mt-6\" data-kid=\"1-1-3\">\n<!-- Toolbar -->\n<div class=\"flex h-12 items-center justify-between\" data-kid=\"1-1-3-1\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-1-3-1-1\">\n<span class=\"text-[12px] font-medium text-slate-700\" data-kid=\"1-1-3-1-1-1\">Product preview</span>\n<span class=\"h-4 w-px bg-slate-300/80\" data-kid=\"1-1-3-1-1-2\"></span>\n<span class=\"text-[12px] text-slate-500\" data-kid=\"1-1-3-1-1-3\">Tuesday</span>\n<span class=\"h-4 w-px bg-slate-300/80\" data-kid=\"1-1-3-1-1-4\"></span>\n<span class=\"rd-mono text-[12px] font-medium text-slate-700\" data-kid=\"1-1-3-1-1-5\" id=\"rd-clock\">08:45</span>\n<span class=\"ml-1 rounded-[6px] bg-slate-200/60 px-1.5 py-1 text-[10px] font-semibold uppercase tracking-[0.07em] text-slate-500\" data-kid=\"1-1-3-1-1-6\">Sample data</span>\n</div>\n<button class=\"inline-flex h-9 items-center gap-2 rounded-[9px] border border-slate-300/80 bg-white px-3 text-[12px] font-medium text-slate-700 shadow-[0_1px_2px_rgba(15,23,42,0.04)] transition-colors duration-150 hover:border-slate-400 hover:text-slate-900\" data-kid=\"1-1-3-1-2\" id=\"rd-pause\" type=\"button\">\n<i class=\"icon-pause\" data-kid=\"1-1-3-1-2-1\" id=\"rd-pause-icon\" style=\"font-size:12px;color:#475569\"></i>\n<span data-kid=\"1-1-3-1-2-2\" id=\"rd-pause-label\">Pause preview</span>\n</button>\n</div>\n<!-- Tabs -->\n<div aria-label=\"Preview views\" class=\"mt-2 flex h-10 items-center gap-6 border-b border-slate-200/90\" data-kid=\"1-1-3-2\" role=\"tablist\">\n<button aria-selected=\"true\" class=\"rd-tab\" data-kid=\"1-1-3-2-1\" data-tab=\"results\" role=\"tab\" type=\"button\">Assessment results</button>\n<button aria-selected=\"false\" class=\"rd-tab\" data-kid=\"1-1-3-2-2\" data-tab=\"timetable\" role=\"tab\" type=\"button\">Timetable</button>\n</div>\n<!-- Selected class strip -->\n<div class=\"mt-6 flex h-[72px] items-center gap-5 rounded-xl bg-white px-5 ring-1 ring-slate-200/80\" data-kid=\"1-1-3-3\">\n<div class=\"w-[104px] shrink-0\" data-kid=\"1-1-3-3-1\">\n<div class=\"rd-micro\" data-kid=\"1-1-3-3-1-1\">Class</div>\n<div class=\"mt-1.5 flex items-baseline gap-1.5\" data-kid=\"1-1-3-3-1-2\">\n<span class=\"text-[15px] font-semibold leading-none text-slate-900\" data-kid=\"1-1-3-3-1-2-1\">8</span>\n<span class=\"text-[12px] leading-none text-slate-500\" data-kid=\"1-1-3-3-1-2-2\">Section A</span>\n</div>\n</div>\n<span class=\"h-8 w-px shrink-0 bg-slate-200\" data-kid=\"1-1-3-3-2\"></span>\n<div class=\"shrink-0\" data-kid=\"1-1-3-3-3\">\n<div class=\"rd-micro\" data-kid=\"1-1-3-3-3-1\">Lesson</div>\n<div class=\"mt-1.5 flex items-center gap-2\" data-kid=\"1-1-3-3-3-2\">\n<span class=\"text-[13px] font-medium leading-none text-slate-900\" data-kid=\"1-1-3-3-3-2-1\">Mathematics</span>\n<span class=\"inline-flex items-center gap-1.5 text-[11px] font-medium leading-none text-emerald-700\" data-kid=\"1-1-3-3-3-2-2\">\n<span class=\"h-1.5 w-1.5 rounded-full bg-emerald-500\" data-kid=\"1-1-3-3-3-2-2-1\"></span>In session\n            </span>\n</div>\n</div>\n<span class=\"h-8 w-px shrink-0 bg-slate-200\" data-kid=\"1-1-3-3-4\"></span>\n<div class=\"shrink-0\" data-kid=\"1-1-3-3-5\">\n<div class=\"rd-micro\" data-kid=\"1-1-3-3-5-1\">Period</div>\n<div class=\"mt-1.5 flex items-center gap-3\" data-kid=\"1-1-3-3-5-2\">\n<span class=\"rd-mono text-[12.5px] leading-none text-slate-700\" data-kid=\"1-1-3-3-5-2-1\">08:30 – 09:10</span>\n<div class=\"relative h-1.5 w-[176px] rounded-full bg-slate-200/80\" data-kid=\"1-1-3-3-5-2-2\">\n<div class=\"absolute inset-y-0 left-0 rounded-full bg-indigo-600\" data-kid=\"1-1-3-3-5-2-2-1\" id=\"rd-strip-fill\" style=\"width:37.5%\"></div>\n<div class=\"absolute top-1/2 h-2.5 w-2.5 -translate-y-1/2 rounded-full bg-indigo-600 ring-2 