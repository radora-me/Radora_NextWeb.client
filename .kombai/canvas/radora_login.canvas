ss=\"text-[12px] text-slate-600\" data-kid=\"1-1-3-4-2-5-4\">Mr. Ishaan Mehta</span>\n<span class=\"text-[12px] text-slate-600\" data-kid=\"1-1-3-4-2-5-5\">Room 118</span>\n</div>\n<div class=\"grid h-10 grid-cols-[86px_200px_minmax(0,1fr)_190px_140px] items-center gap-4 px-5\" data-kid=\"1-1-3-4-2-6\">\n<span class=\"rd-mono text-[12.5px] text-slate-600\" data-kid=\"1-1-3-4-2-6-1\">12:15</span>\n<span class=\"text-[13px] text-slate-900\" data-kid=\"1-1-3-4-2-6-2\">Sports</span>\n<span class=\"text-[12px] text-slate-600\" data-kid=\"1-1-3-4-2-6-3\">Class 8 / A</span>\n<span class=\"text-[12px] text-slate-600\" data-kid=\"1-1-3-4-2-6-4\">Ms. Mira Shah</span>\n<span class=\"text-[12px] text-slate-600\" data-kid=\"1-1-3-4-2-6-5\">Sports ground</span>\n</div>\n</div>\n</div>\n</section>\n<!-- Footer -->\n<footer class=\"mt-6 flex h-4 items-center justify-between text-[11px] text-slate-400\" data-kid=\"1-1-4\">\n<span data-kid=\"1-1-4-1\">© 2026 Radora Technologies Inc.</span>\n<a class=\"transition-colors duration-150 hover:text-slate-600\" data-kid=\"1-1-4-2\" href=\"#\">office@radora.tech</a>\n</footer>\n</div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script>\n  (function () {\n    var START = 0.375;\n    var DAY_START = 8 * 60 + 30;\n    var LESSON_MIN = 40;\n\n    var clockEl = document.getElementById('rd-clock');\n    var stripFill = document.getElementById('rd-strip-fill');\n    var stripKnob = document.getElementById('rd-strip-knob');\n    var ttFill = document.getElementById('rd-tt-fill');\n    var preview = { p: START };\n\n    function pad(n) { return (n < 10 ? '0' : '') + n; }\n\n    function render() {\n      var p = preview.p;\n      var pct = (p * 100) + '%';\n      if (stripFill) stripFill.style.width = pct;\n      if (stripKnob) stripKnob.style.left = pct;\n      if (ttFill) ttFill.style.width = pct;\n      if (clockEl) {\n        var mins = DAY_START + LESSON_MIN * p;\n        clockEl.textContent = pad(Math.floor(mins / 60)) + ':' + pad(Math.floor(mins % 60));\n      }\n    }\n\n    render();\n\n    if (window.gsap) {\n      var tween = gsap.to(preview, { p: 1, duration: 48, ease: 'none', repeat: -1, onUpdate: render });\n\n      var pauseBtn = document.getElementById('rd-pause');\n      var pauseIcon = document.getElementById('rd-pause-icon');\n      var pauseLabel = document.getElementById('rd-pause-label');\n      var playing = true;\n\n      if (pauseBtn) {\n        pauseBtn.addEventListener('click', function () {\n          playing = !playing;\n          if (playing) {\n            tween.resume();\n            pauseLabel.textContent = 'Pause preview';\n            pauseIcon.className = 'icon-pause';\n          } else {\n            tween.pause();\n            pauseLabel.textContent = 'Play preview';\n            pauseIcon.className = 'icon-play';\n          }\n          pauseBtn.setAttribute('aria-pressed', String(!playing));\n        });\n      }\n    }\n\n    var eyeBtn = document.getElementById('rd-eye');\n    var eyeIcon = document.getElementById('rd-eye-icon');\n    var passwordInput = document.getElementById('rd-password');\n\n    if (eyeBtn && passwordInput) {\n      eyeBtn.addEventListener('click', function () {\n        var hidden = passwordInput.type === 'password';\n        passwordInput.type = hidden ? 'text' : 'password';\n        eyeIcon.className = hidden ? 'icon-eye-off' : 'icon-eye';\n        eyeBtn.setAttribute('aria-label', hidden ? 'Hide password' : 'Show password');\n      });\n    }\n\n    var tabs = Array.prototype.slice.call(document.querySelectorAll('[data-tab]'));\n    var panels = Array.prototype.slice.call(document.querySelectorAll('[data-panel]'));\n\n    function selectTab(name) {\n      tabs.forEach(function (tab) {\n        tab.setAttribute('aria-selected', String(tab.getAttribute('data-tab') === name));\n      });\n      panels.forEach(function (panel) {\n        var active = panel.getAttribute('data-panel') === name;\n        panel.style.opacity = active ? '1' : '0';\n        panel.classList.toggle('pointer-events-none', !active);\n        panel.setAttribute('aria-hidden', String(!active));\n      });\n    }\n\n    tabs.forEach(function (tab) {\n      tab.addEventListener('click', function () {\n        selectTab(tab.getAttribute('data-tab'));\n      });\n    });\n  })();\n</script>",
