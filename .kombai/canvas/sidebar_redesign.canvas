      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n  :root{\n    --sb-bg: oklch(0.175 0.015 265);\n    --sb-fg: oklch(0.92 0.005 265);\n    --sb-accent: oklch(0.24 0.02 265);\n    --indigo: oklch(0.62 0.19 265);\n    --indigo-strong: oklch(0.488 0.243 264.376);\n    --indigo-soft: oklch(0.73 0.15 272);\n    --app-bg: oklch(0.985 0.002 250);\n    --card: oklch(1 0 0);\n    --border: oklch(0.915 0.008 265);\n    --muted: oklch(0.52 0.02 265);\n    --fg: oklch(0.145 0.015 265);\n    --destructive: oklch(0.577 0.245 27.325);\n  }\n  body{margin:0;font-family:'Inter',ui-sans-serif,system-ui,sans-serif}\n  .nav-scroll::-webkit-scrollbar{width:4px}\n  .nav-scroll::-webkit-scrollbar-track{background:transparent}\n  .nav-scroll::-webkit-scrollbar-thumb{background:oklch(0.28 0.02 265);border-radius:99px}\n</style>\n<div class=\"flex h-screen min-h-[860px] w-full overflow-hidden bg-[var(--app-bg)] text-[var(--fg)] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n<aside class=\"flex h-full w-64 shrink-0 flex-col bg-[var(--sb-bg)] text-[var(--sb-fg)]\" data-kid=\"1-1\" data-name=\"sidebar navigation panel\">\n<div class=\"flex h-[72px] shrink-0 items-center gap-2 px-4\" data-kid=\"1-1-1\" data-name=\"sidebar header with logo\">\n<a class=\"flex min-w-0 flex-1 items-center gap-2.5\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"/teacher-dashboard\">\n<span class=\"flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-[10px] bg-white/[0.06] ring-1 ring-white/12\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo icon container\">\n<img alt=\"Radora Next\" class=\"h-9 w-9 object-cover\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand logo image\" decoding=\"async\" height=\"36\" loading=\"lazy\" src=\"/api/local/images/public/logo/Next1.png\" width=\"36\"/>\n</span>\n<span class=\"min