      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n  :root{\n    --sb-bg: oklch(0.175 0.015 265);\n    --sb-fg: oklch(0.92 0.005 265);\n    --sb-accent: oklch(0.24 0.02 265);\n    --indigo: oklch(0.62 0.19 265);\n    --indigo-strong: oklch(0.488 0.243 264.376);\n    --indigo-soft: oklch(0.73 0.15 272);\n    --app-bg: oklch(0.985 0.002 250);\n    --card: oklch(1 0 0);\n    --border: oklch(0.915 0.008 265);\n    --muted: oklch(0.52 0.02 265);\n    --fg: oklch(0.145 0.015 265);\n    --destructive: oklch(0.577 0.245 27.325);\n  }\n  body{margin:0;font-family:'Inter',ui-sans-serif,system-ui,sans-serif}\n  .nav-scroll::-webkit-scrollbar{width:4px}\n  .nav-scroll::-webkit-scrollbar-track{background:transparent}\n  .nav-scroll::-webkit-scrollbar-thumb{background:oklch(0.28 0.02 265);border-radius:99px}\n</style>\n<div class=\"flex h-screen min-h-[860px] w-full overflow-hidden bg-[var(--app-bg)] text-[var(--fg)] antialiased\" data-kid=\"1\" data-name=\"app shell layout container\">\n<aside class=\"flex h-full w-64 shrink-0 flex-col bg-[var(--sb-bg)] text-[var(--sb-fg)]\" data-kid=\"1-1\" data-name=\"dark student sidebar\">\n<div class=\"flex h-[72px] shrink-0 items-center gap-2 px-4\" data-kid=\"1-1-1\" data-name=\"sidebar brand header row\">\n<a class=\"flex min-w-0 flex-1 items-center gap-2.5\" data-kid=\"1-1-1-1\" data-name=\"brand logo and label link\" href=\"/student-dashboard\">\n<span class=\"flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-[10px] bg-white/[0.06] ring-1 ring-white/12\" data-kid=\"1-1-1-1-1\" data-name=\"logo image frame\">\n<img alt=\"Radora Next\" class=\"h-9 w-9 object-cover\" data-kid=\"1-1-1-1-1-1\" data-name=\"application logo image\" decoding=\"async\" height=\"36\" loading=\"lazy\" src=\"/api/local/images/public/logo/Next1.png\" width=\"36\"/>\n</span>\n<span class=\"min-w-0\" data-kid=\"1-1-1-1-2\" data-name=\"brand text block\">\n<span class=\"block truncate text-[13px] font-semibold leading-4\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand name text\">Radora Next</span>\n<span class=\"mt-[3px] block truncate text-[11px] leading-3 text-white/45\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand role subtitle\">Student</span>\n</span>\n</a>\n<button aria-label=\"Collapse sidebar\" class=\"flex h-7 w-7 shrink-0 items-center justify-center rounded-md text-white/40 hover:bg-white/[0.06] hover:text-white/80\" data-kid=\"1-1-1-2\" data-name=\"collapse sidebar button\" type=\"button\">\n<i class=\"icon-panel-left text-[15px]\" data-kid=\"1-1-1-2-1\" data-name=\"panel-left collapse icon\"></i>\n</button>\n</div>\n<div class=\"shrink-0 px-2 pb-2\" data-kid=\"1-1-2\" data-name=\"sidebar search wrapper\">\n<div class=\"relative\" data-kid=\"1-1-2-1\" data-name=\"sidebar search field container\">\n<i class=\"icon-search pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 text-[14px] text-white/30\" data-kid=\"1-1-2-1-1\" data-name=\"search magnifier icon\"></i>\n<input class=\"h-9 w-full rounded-md border border-white/[0.08] bg-white/[0.04] pl-8 pr-2 text-[12.5px] text-white/90 placeholder:text-white/35 focus:border-[var(--indigo)] focus:outline-none\" data-kid=\"1-1-2-1-2\" data-name=\"navigation filter input field\" placeholder=\"Filter navigation\" type=\"text\"/>\n</div>\n</div>\n<nav aria-label=\"Student\" class=\"nav-scroll flex-1 overflow-y-auto overflow-x-hidden px-2 pb-3\" data-kid=\"1-1-3\" data-name=\"sidebar main navigation\">\n<div class=\"space-y-1.5\" data-kid=\"1-1-3-1\" data-name=\"sidebar navigation sections list\">\n<div data-kid=\"1-1-3-1-1\" data-name=\"Overview nav group\">\n<button aria-expanded=\"true\" class=\"flex h-6 w-full items-center gap-2 rounded-md px-2 text-[11px] font-medium text-white/40 hover:text-white/75\" data-kid=\"1-1-3-1-1-1\" data-name=\"Overview section toggle button\" type=\"button\">\n<