      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n  :root{\n    --sb-bg: oklch(0.175 0.015 265);\n    --sb-fg: oklch(0.92 0.005 265);\n    --sb-accent: oklch(0.24 0.02 265);\n    --sb-pop: oklch(0.24 0.02 265);\n    --indigo: oklch(0.62 0.19 265);\n    --indigo-strong: oklch(0.488 0.243 264.376);\n    --indigo-soft: oklch(0.74 0.14 272);\n    --app-bg: oklch(0.985 0.002 250);\n    --card: oklch(1 0 0);\n    --border: oklch(0.915 0.008 265);\n    --muted: oklch(0.52 0.02 265);\n    --fg: oklch(0.145 0.015 265);\n    --board: oklch(0.958 0.004 265);\n    --active-light: oklch(0.955 0.022 272);\n  }\n  body{margin:0;font-family:'Inter',ui-sans-serif,system-ui,sans-serif}\n  .rail-scroll::-webkit-scrollbar{width:0}\n  .nav-scroll::-webkit-scrollbar{width:4px}\n  .nav-scroll::-webkit-scrollbar-thumb{background:oklch(0.28 0.02 265);border-radius:99px}\n</style>\n<div class=\"min-h-screen w-full bg-[var(--board)] p-8 text-[var(--fg)] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n<div class=\"flex items-end justify-start gap-6\" data-kid=\"1-1\" data-name=\"app preview layout row\">\n<div class=\"flex h-[740px] shrink-0 overflow-hidden rounded-xl bg-[var(--card)] shadow-[0_1px_3px_oklch(0.2_0.02_265_/_0.10)] ring-1 ring-black/5\" data-kid=\"1-1-1\" data-name=\"dark theme sidebar panel mockup\">\n<div class=\"relative flex h-full w-14 flex-col bg-[var(--sb-bg)]\" data-kid=\"1-1-1-1\" data-name=\"dark icon rail sidebar\">\n<div class=\"flex h-[56px] shrink-0 items-center justify-center\" data-kid=\"1-1-1-1-1\" data-name=\"sidebar logo header container\">\n<span class=\"flex h-8 w-8 items-center justify-center overflow-hidden rounded-lg bg-white/[0.06] ring-1 ring-white/12\" data-kid=\"1-1-1-1-1-1\" data-name=\"app logo avatar badge\">\n<img alt=\"Radora Next\" class=\"h-8 w-8 object-cover\" data-k