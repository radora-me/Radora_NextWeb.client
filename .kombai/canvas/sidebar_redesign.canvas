over:bg-white/[0.04] hover:text-white\" data-kid=\"1-1-3-1-2-2-1-1\" data-name=\"My Attendance nav link\" href=\"/student-attendance\">\n<i class=\"icon-clock text-[16px] text-white/45\" data-kid=\"1-1-3-1-2-2-1-1-1\" data-name=\"clock icon\"></i>\n<span class=\"flex-1 truncate\" data-kid=\"1-1-3-1-2-2-1-1-2\" data-name=\"My Attendance nav label\">My Attendance</span>\n</a>\n</li>\n<li data-kid=\"1-1-3-1-2-2-2\" data-name=\"nav list item container\">\n<a aria-current=\"page\" class=\"flex h-8 items-center gap-2.5 rounded-md bg-[var(--sb-accent)] px-2 text-[13px] font-medium text-white\" data-kid=\"1-1-3-1-2-2-2-1\" data-name=\"active Homework nav link\" href=\"/student-homework\">\n<i class=\"icon-book-open text-[16px] text-[var(--indigo-soft)]\" data-kid=\"1-1-3-1-2-2-2-1-1\" data-name=\"open book icon\"></i>\n<span class=\"flex-1 truncate\" data-kid=\"1-1-3-1-2-2-2-1-2\" data-name=\"Homework nav label\">Homework</span>\n<span class=\"rounded bg-[var(--indigo-soft)]/15 px-1.5 text-[10px] font-medium leading-4 tabular-nums text-[var(--indigo-soft)]\" data-kid=\"1-1-3-1-2-2-2-1-3\" data-name=\"unread homework count badge\">3</span>\n</a>\n</li>\n<li data-kid=\"1-1-3-1-2-2-3\" data-name=\"nav list item container\">\n<a class=\"flex h-8 items-center gap-2.5 rounded-md px-2 text-[13px] text-white/80 hover:bg-white/[0.04] hover:text-white\" data-kid=\"1-1-3-1-2-2-3-1\" data-name=\"Timetable nav link\" href=\"/student-timetable\">\n<i class=\"icon-calendar text-[16px] text-white/45\" data-kid=\"1-1-3-1-2-2-3-1-1\" data-name=\"calendar icon\"></i>\n<span class=\"flex-1 truncate\" data-kid=\"1-1-3-1-2-2-3-1-2\" data-name=\"Timetable nav label\">Timetable</span>\n</a>\n</li>\n<li data-kid=\"1-1-3-1-2-2-4\" data-name=\"nav list item container\">\n<a class=\"flex h-8 items-center gap-2.5 rounded-md px-2 text-[13px] text-white/80 hover:bg-white/[0.04] hover:text-white\" data-kid=\"1-1-3-1-2-2-4-1\" data-name=\"Proctored Tests nav link\" href=\"/student-tests\">\n<i class=\"icon-clipboard-check text-[16px] text-white/45\" data-kid=\"1-1-3-1-2-2-4-1-1\" data-name=\"clipboard check icon\"></i>\n<span class=\"flex-1 truncate\" data-kid=\"1-1-3-1-2-2-4-1-2\" data-name=\"Proctored Tests nav label\">Proctored Tests</span>\n</a>\n</li>\n<li data-kid=\"1-1-3-1-2-2-5\" data-name=\"nav list item container\">\n<a class=\"flex h-8 items-center gap-2.5 rounded-md px-2 text-[13px] text-white/80 hover:bg-white/[0.04] hover:text-white\" data-kid=\"1-1-3-1-2-2-5-1\" data-name=\"Class Leaderboard nav link\" href=\"/student-leaderboard\">\n<i class=\"icon-trophy text-[16px] text-white/45\" data-kid=\"1-1-3-1-2-2-5-1-1\" data-name=\"trophy icon\"></i>\n<span class=\"flex-1 truncate\" data-kid=\"1-1-3-1-2-2-5-1-2\" data-name=\"Class Leaderboard nav label\">Class Leaderboard</span>\n</a>\n</li>\n</ul>\n</div>\n<div data-kid=\"1-1-3-1-3\" data-name=\"Communication nav group\">\n<button aria-expanded=\"true\" class=\"flex h-6 w-full items-center gap-2 rounded-md px-2 text-[11px] font-medium text-white/40 hover:text-white/75\" data-kid=\"1-1-3-1-3-1\" data-name=\"Communication section toggle button\" type=\"button\">\n<span class=\"flex-1 truncate text-left\" data-kid=\"1-1-3-1-3-1-1\" data-name=\"Communication section label\">Communication</span>\n<span class=\"text-[10.5px] tabular-nums text-white/25\" data-kid=\"1-1-3-1-3-1-2\" data-name=\"item count badge text\">3</span>\n<i class=\"icon-chevron-down text-[12px] text-white/25\" data-kid=\"1-1-3-1-3-1-3\" data-name=\"chevron-down expand icon\"></i>\n</button>\n<ul class=\"mt-0.5 space-y-px\" data-kid=\"1-1-3-1-3-2\" data-name=\"Communication nav link list\">\n<li data-kid=\"1-1-3-1-3-2-1\" data-name=\"nav list item container\">\n<a class=\"flex h-8 items-center gap-2.5 rounded-md px-2 text-[13px] text-white/80 hover:bg-white/[0.04] hover:text-white\" data-kid=\"1-1-3-1-3-2-1-1\" data-name=\"AI Assistant nav link\" href=\"/student-ai-chat\">\n<i class=\"icon-bot text-[16px] text-white/45\" data-kid=\"1-1-3-1-3-2-1-1-1\" data-name=\"bot icon\"></i>\n<span class=\"flex-1 truncate\" data-kid=\"1-1-3-1-3-2-1-1-2\" data-name=\"AI Assistant nav label\">AI Assistant</span>\n</a>\n</li>\n<li data-kid=\"1-1-3-1-3-2-2\" data-name=\"nav list item container\">\n<a class=\"flex h-8 items-center gap-2.5 rounded-md px-2 text-[13px] text-white/80 hover:bg-white/[0.04] hover:text-white\" data-kid=\"1-1-3-1-3-2-2-1\" data-name=\"Classroom Chat nav link\" href=\"/student-classroom-chat\">\n<i class=\"icon-message-square text-[16px] text-white/45\" data-kid=\"1-1-3-1-3-2-2-1-1\" data-name=\"message square icon\"></i>\n<span class=\"flex-1 truncate\" data-kid=\"1-1-3-1-3-2-2-1-2\" data-name=\"Classroom Chat nav label\">Classroom Chat</span>\n</a>\n</li>\n<li data-kid=\"1-1-3-1-3-2-3\" data-name=\"nav list item container\">\n<a class=\"flex h-8 items-center gap-2.5 rounded-md px-2 text-[13px] text-white/80 hover:bg-white/[0.04] hover:text-white\" data-kid=\"1-1-3-1-3-2-3-1\" data-name=\"Notice Board nav link\" href=\"/student-notifications\">\n<i class=\"icon-bell text-[16px] text-white/45\" data-kid=\"1-1-3-1-3-2-3-1-1\" data-name=\"bell icon\"></i>\n<span class=\"flex-1 truncate\" data-kid=\"1-1-3-1-3-2-3-1-2\" data-name=\"Notice Board nav label\">Notice Board</span>\n<span class=\"rounded bg-[var(--indigo-soft)]/15 px-1.5 text-[10px] font-medium leading-4 tabular-nums text-[var(--indigo-soft)]\" data-kid=\"1-1-3-1-3-2-3-1-3\" data-name=\"unread notice count badge\">4</span>\n</a>\n</li>\n</ul>\n</div>\n<div data-kid=\"1-1-3-1-4\" data-name=\"Resources nav group\">\n<button aria-expanded=\"true\" class=\"flex h-6 w-full items-center gap-2 rounded-md px-2 text-[11px] font-medium text-white/40 hover:text-white/75\" data-kid=\"1-1-3-1-4-1\" data-name=\"Resources section toggle button\" type=\"button\">\n<span class=\"flex-1 truncate text-left\" data-kid=\"1-1-3-1-4-1-1\" data-name=\"Resources section label\">Resources</span>\n<span class=\"text-[10.5px] tabular-nums text-white/25\" data-kid=\"1-