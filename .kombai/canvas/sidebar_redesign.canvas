      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n  :root{\n    --indigo: oklch(0.62 0.19 265);\n    --indigo-strong: oklch(0.488 0.243 264.376);\n    --indigo-soft: oklch(0.73 0.15 272);\n    --app-bg: oklch(0.985 0.002 250);\n    --card: oklch(1 0 0);\n    --border: oklch(0.915 0.008 265);\n    --muted: oklch(0.52 0.02 265);\n    --fg: oklch(0.145 0.015 265);\n    --active-light: oklch(0.955 0.022 272);\n  }\n  body{margin:0;font-family:'Inter',ui-sans-serif,system-ui,sans-serif}\n  .nav-scroll::-webkit-scrollbar{width:4px}\n  .nav-scroll::-webkit-scrollbar-track{background:transparent}\n  .nav-scroll::-webkit-scrollbar-thumb{background:oklch(0.885 0.008 265);border-radius:99px}\n</style>\n<div class=\"flex h-screen min-h-[860px] w-full overflow-hidden bg-[var(--app-bg)] text-[var(--fg)] antialiased\" data-kid=\"1\" data-name=\"app layout root container\">\n<aside class=\"flex h-full w-64 shrink-0 flex-col border-r border-[var(--border)] bg-[var(--card)] text-[var(--fg)]\" data-kid=\"1-1\" data-name=\"admin sidebar navigation\">\n<div class=\"flex h-[72px] shrink-0 items-center gap-2 px-4\" data-kid=\"1-1-1\" data-name=\"sidebar header with brand and collapse\">\n<a class=\"flex min-w-0 flex-1 items-center gap-2.5\" data-kid=\"1-1-1-1\" data-name=\"brand logo link to dashboard\" href=\"/dashboard\">\n<span class=\"flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-[10px] bg-[var(--app-bg)] ring-1 ring-[var(--border)]\" data-kid=\"1-1-1-1-1\" data-name=\"logo image container\">\n<img alt=\"Radora Next\" class=\"h-9 w-9 object-cover\" data-kid=\"1-1-1-1-1-1\" data-name=\"Radora Next logo image\" decoding=\"async\" height=\"36\" loading=\"lazy\" src=\"/api/local/images/public/logo/Next1.png\" width=\"36\"/>\n</span>\n<span class=\"min-w-0\" data-kid=\"1-1-1-1-2\" data-name=\"brand text block\">\n<span class=\"block truncate text-[13px] font-semibold leading-4\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand name text\">Radora Next</span>\n<span class=\"mt-[3px] block truncate text-[11px] leading-3 text-[var(--muted)]\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand subtitle text\">Administration</span>\n</span>\n</a>\n<button aria-label=\"Collapse sidebar\" class=\"flex h-7 w-7 shrink-0 items-center justify-center rounded-md text-[var(--muted)] hover:bg-[var(--app-bg)] hover:text-[var(--fg)]\" data-kid=\"1-1-1-2\" data-name=\"collapse sidebar button\" type=\"button\">\n<i class=\"icon-panel-left text-[15px]\" data-kid=\"1-1-1-2-1\" data-name=\"panel left icon\"></i>\n</button>\n</div>\n<div class=\"shrink-0 px-2 pb-2\" data-kid=\"1-1-2\" data-name=\"navigation filter wrapper\">\n<div class=\"relative\" data-kid=\"1-1-2-1\" data-name=\"navigation filter input wrapper\">\n<i class=\"icon-search pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 text-[14px] text-[var(--muted)]\" data-kid=\"1-1-2-1-1\" data-name=\"search icon in filter input\"></i>\n<input class=\"h-9 w-full rounded-md border border-[var(--border)] bg-[var(--app-bg)] pl-8 pr-2 text-[12.5px] text-[var(--fg)] placeholder:text-[var(--muted)]/80 focus:border-[var(--indigo)] focus:outline-none\" data-kid=\"1-1-2-1-2\" data-name=\"navigation filter input field\" placeholder=\"Filter navigation\" type=\"text\"/>\n</div>\n</div>\n<nav aria-label=\"Admin\" class=\"nav-scroll flex-1 overflow-y-auto overflow-x-hidden px-2 pb-3\" data-kid=\"1-1-3\" data-name=\"admin navigation menu\">\n<div class=\"space-y-1.5\" data-kid=\"1-1-3-1\" data-name=\"nav menu sections container\">\n<div data-kid=\"1-1-3-1-1\" data-name=\"overview nav group\">\n<button aria-expanded=\"true\" class=\"flex h-6 w-full items-center gap-2 rounded-md px-2 text-[11px] font-medium text-[var(--muted)] hover:text-[var(--fg)]\" data-kid=\"1-1-3-1-1-1\" data-name=\"overview nav section toggle\" type=\"button\">\n<span class=\"flex-1 truncate text-left\" data-kid=\"1-1-3-1-1-1-1\" data-name=\"overview section label\">Overview</span>\n<span class=\"text-[10.5px] tabular-nums text-[var(--muted)]/60\" data-kid=\"1-1-3-1-1-1-2\" data-name=\"overview item count badge\">1</span>\n<i class=\"icon-chevron-down text-[12px] text-[var(--muted)]/50\" data-kid=\"1-1-3-1-1-1-3\" data-name=\"chevron down icon\"></i>\n</button>\n<ul class=\"mt-0.5 space-y-px\" data-kid=\"1-1-3-1-1-2\" data-name=\"overview nav link list\">\n<li data-kid=\"1-1-3-1-1-2-1\" data-name=\"dashboard nav item\">\n<a class=\"flex h-8 items-center gap-2.5 rounded-md px-2 text-[13px] text-[var(--fg)] hover:bg-[var(--app-bg)]\" data-kid=\"1-1-3-1-1-2-1-1\" data-name=\"Dashboard nav link\" href=\"/dashboard\">\n<i class=\"icon-layout-dashboard text-[16px] text-[var(--muted)]\" data-kid=\"1-1-3-1-1-2-1-1-1\" data-name=\"dashboard layout icon\"></i>\n<span class=\"flex-1 truncate\" data-kid=\"1-1-3-1-1-2-1-1-2\" data-name=\"Dashboard nav link label\">Dashboard</span>\n</a>\n</li>\n</ul>\n</div>\n<div data-kid=\"1-1-3-1-2\" data-name=\"people nav group\">\n<button aria-expanded=\"true\" class=\"flex h-6 w-full items-center gap-2 rounded-md px-2 text-[11px] font-medium text-[var(--muted)] hover:text-[var(--fg)]\" data-kid=\"1-1-3-1-2-1\" data-name=\"people nav section toggle\" type=\"button\">\n<span class=\"flex-1 truncate text-left\" data-kid=\"1-1-3-1-2-1-1\" data-name=\"people section label\">People</span>\n<span class=\"text-[10.5px] tabular-nums text-[var(--muted)]/60\" data-kid=\"1-1-3-1-2-1-2\" data-name=\"people item count badge\">3</span>\n<i class=\"icon-chevron-down text-[12px] text-[var(--muted)]/50\" data-kid=\"1-1-3-1-2-1-3\" data-name=\"chevron down icon\"></i>\n</button>\n<ul class=\"mt-0.5 space-y-px\" data-kid=\"1-1-3-1-2-2\" data-name=\"people nav link list\">\n<li data-kid=\"1-1-3-1-2-2-1\" data-name=\"students nav item\">\n<a aria-current=\"page\" class=\"flex h-8 items-center gap-2.5 rounded-md bg-[var(--active-light